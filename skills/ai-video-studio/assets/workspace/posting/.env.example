# Copy to .env. NEVER commit .env, token.json, client_secrets.json or any Instagram token.
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json
# Instagram (official Graph API, setup: ai-video-studio/references/instagram-official-api.md). Fill in yourself, never paste in chat.
# One pair per account; names must match user_id_env / token_env in accounts.json.
# IG_API_USER_ID_MAIN=
# IG_API_TOKEN_MAIN=
# META_APP_ID=
# META_APP_SECRET=
